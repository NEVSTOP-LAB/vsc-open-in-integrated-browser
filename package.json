{
  "name": "vsc-open-in-integrated-browser",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "NEVSTOP-LAB",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NEVSTOP-LAB/vsc-open-in-integrated-browser.git"
  },
  "bugs": {
    "url": "https://github.com/NEVSTOP-LAB/vsc-open-in-integrated-browser/issues"
  },
  "homepage": "https://github.com/NEVSTOP-LAB/vsc-open-in-integrated-browser#readme",
  "keywords": [
    "browser",
    "simple browser",
    "integrated browser",
    "preview",
    "html",
    "pdf",
    "svg",
    "image",
    "context menu"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openInIntegratedBrowser.open",
        "title": "%command.openInIntegratedBrowser.open.title%",
        "category": "%command.openInIntegratedBrowser.category%"
      }
    ],
    "customEditors": [
      {
        "viewType": "openInIntegratedBrowser.integratedBrowserEditor",
        "displayName": "%customEditor.openInIntegratedBrowser.displayName%",
        "selector": [
          { "filenamePattern": "*.html" },
          { "filenamePattern": "*.htm" },
          { "filenamePattern": "*.pdf" },
          { "filenamePattern": "*.svg" },
          { "filenamePattern": "*.xml" },
          { "filenamePattern": "*.xsl" }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname in openInIntegratedBrowser.supportedExtnames",
          "command": "openInIntegratedBrowser.open",
          "group": "navigation@99"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceExtname in openInIntegratedBrowser.supportedExtnames",
          "command": "openInIntegratedBrowser.open",
          "group": "1_open@99"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname in openInIntegratedBrowser.supportedExtnames",
          "command": "openInIntegratedBrowser.open",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "openInIntegratedBrowser.open",
          "when": "resourceExtname in openInIntegratedBrowser.supportedExtnames"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "openInIntegratedBrowser.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "html",
            "htm",
            "pdf",
            "svg",
            "xml",
            "xsl"
          ],
          "markdownDescription": "%configuration.extensions.description%"
        },
        "openInIntegratedBrowser.autoAssociateExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "%configuration.autoAssociateExtensions.description%"
        },
        "openInIntegratedBrowser.setHtmlAsDefaultEditor": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "%configuration.setHtmlAsDefaultEditor.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
